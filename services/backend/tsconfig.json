{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@radio-ai/contracts": ["packages/contracts/src/index.ts"],
      "@/*": ["src/*"],
      "@web/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/src/**/*.ts",
    "../../src/app/lib/**/*.ts"
  ]
}
