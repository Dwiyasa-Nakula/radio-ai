PORT=8080
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:3000
BACKEND_SESSION_SECRET=replace-with-the-same-32-plus-character-secret-used-by-vercel
BACKEND_PUBLIC_URL=https://your-radio-backend.example.com
YOUTUBE_STREAMING_ENABLED=true
YOUTUBE_PO_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_PROXY_URL=http://login:password@hostname:port
# Docker sets this to its pinned Python yt-dlp. Leave unset for local npm fallback.
YT_DLP_PATH=
# Comma-separated SHA-256 hashes. Generate one with:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" your-device-secret
MOBILE_DEVICE_CREDENTIAL_HASHES=
YOUTUBE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
OPENAGENTIC_API_KEY=
OPENAGENTIC_MODEL=claude-sonnet-4.5-thinking
GEMINI_API_KEY=
GEMINI_VOICE_NAME=Laomedeia
GEMINI_VOICE_CHATTER=Laomedeia
GEMINI_VOICE_NEWS=Erinome
GEMINI_VOICE_WEATHER=Aoede
GEMINI_VOICE_TRAFFIC=Pulcherrima
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
ANYVOICELAB_NONCE=
ANYVOICELAB_NONCE_EN=
