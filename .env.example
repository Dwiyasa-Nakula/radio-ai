# Local Next.js fallback APIs
YOUTUBE_API_KEY=
LOCAL_MUSIC_DIR=
ENABLE_LOCAL_FILESYSTEM_API=false
ENABLE_LOCAL_BACKEND_API=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOMTOM_API_KEY=
ANYVOICELAB_NONCE=
ANYVOICELAB_NONCE_EN=
ANYVOICELAB_COOKIE=
ANYVOICELAB_VOICE_ID=656306
ANYVOICELAB_VOICE_ID_EN=656224
ANYVOICELAB_LANGUAGE=ja
ANYVOICELAB_LANGUAGE_EN=en

# Optional personal web access gate (server-side only)
WEB_ACCESS_USERNAME=radio
WEB_ACCESS_PASSWORD=replace-with-a-long-unique-password

# Vercel -> Cloud Run session exchange (server-side only)
BACKEND_URL=https://radio-ai-backend-xxxxxxxxxx-as.a.run.app
BACKEND_SESSION_SECRET=replace-with-at-least-32-random-characters
