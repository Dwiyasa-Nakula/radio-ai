# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!services/backend/.env.example
cookies.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
/.claude/

# media files
/public/audio/*
!/public/audio/bgm.mp3
/public/jingles/*
!/public/jingles/.gitkeep
/public/Intro jingles/*
!/public/Intro jingles/.gitkeep
/public/Outro Jingle/*
!/public/Outro Jingle/.gitkeep
/public/ads/*
!/public/ads/.gitkeep

# backend build output
/services/backend/dist/

# Android build output and local signing/configuration
/android-auto/.gradle/
/android-auto/build/
/android-auto/app/build/
/android-auto/local.properties
/android-auto/*.apk
/android-auto/*.aab
/android-auto/*.jks
/android-auto/keystore.properties
